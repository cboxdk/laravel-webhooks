{
    "name": "cboxdk/laravel-webhooks",
    "description": "Cbox Webhooks: the outbound and inbound webhook engine for Laravel. A persistent outbox with per-endpoint sequencing, backoff with jitter, batching, a circuit breaker with auto-disable, a per-attempt delivery log, replay, pruning, a monitoring surface, management API controllers and a receiver that verifies, dedupes and dispatches.",
    "keywords": [
        "cbox",
        "laravel",
        "webhooks",
        "outbox",
        "circuit-breaker",
        "standard-webhooks",
        "ssrf"
    ],
    "homepage": "https://github.com/cboxdk/laravel-webhooks",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cboxdk/laravel-webhooks/issues",
        "source": "https://github.com/cboxdk/laravel-webhooks"
    },
    "authors": [
        {
            "name": "Sylvester Damgaard",
            "email": "sn@cbox.dk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "cboxdk/laravel-ssrf": "^1.5",
        "cboxdk/laravel-webhook-signature": "^0.1",
        "guzzlehttp/psr7": "^2.7 || ^3.0",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/encryption": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "psr/log": "^3.0",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "cboxdk/laravel-telemetry": "^3.8",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "suggest": {
        "cboxdk/laravel-telemetry": "Metrics, spans and trace propagation for every delivery and receipt, bound automatically when installed (^3.8)."
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Webhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Webhooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Webhooks\\WebhooksServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "sbom-check": [
            "@sbom",
            "git diff --exit-code sbom.json"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev",
            "@sbom-check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
